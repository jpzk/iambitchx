<?xml version="1.0" encoding="UTF-8"?>
<component type="console-application">
  <id>io.github.jpzk.iambitchx</id>

  <name>iambitchx</name>
  <summary>TUI Matrix client for Vim addicts</summary>
  <url type="homepage">https://iamb.chat</url>

  <releases>
    <release version="0.1.1" date="2026-11-27"/>
    <release version="0.1.0" date="2026-11-26"/>
    <release version="0.13.1" date="2026-10-21"/>
    <release version="0.0.13" date="2026-10-21"/>
    <release version="0.0.12" date="2026-09-19"/>
    <release version="0.0.11" date="2026-01-19"/>
    <release version="0.0.10" date="2024-08-20"/>
    <release version="0.0.9" date="2024-03-28"/>
  </releases>

  <developer id="dev.ulyssa">
    <name>Ulyssa</name>
  </developer>

  <developer_name>Ulyssa</developer_name>
  <metadata_license>CC-BY-SA-4.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>

  <branding>
    <color type="primary" scheme_preference="light">#fafafa</color>
    <color type="primary" scheme_preference="dark">#282d3f</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://iamb.chat/static/images/metainfo-screenshot.png</image>
      <caption>Example screenshot of room and lists of rooms, spaces and members within iambitchx</caption>
    </screenshot>
  </screenshots>

  <description>
    <p>
        iambitchx is a fork of iamb with an optional BitchX-style frontend. It is
        a client for the Matrix communication protocol, and provides a
        terminal user interface with familiar Vim keybindings, and includes
        support for multiple profiles, threads, spaces, notifications,
        reactions, custom keybindings, and more.
    </p>
  </description>

  <launchable type="desktop-id">iambitchx.desktop</launchable>

  <categories>
    <category>Network</category>
    <category>Chat</category>
  </categories>

  <provides>
    <binary>iambitchx</binary>
  </provides>
</component>
